<PipelineDescription sampLo="1" sampHi="1">
	<VertexInput rate="vertex" size="32">
		<VertexComponent usage="POS0" format="vec4" offset="0">
		</VertexComponent>
		<VertexComponent usage="TEX0" format="vec4" offset="16">
		</VertexComponent>		
	</VertexInput>
	<PrimitiveType type="trilists">
	</PrimitiveType>
	<CullMode mode="none" winding="ccw">
	</CullMode>
	<DepthTest op="less" write="true">
	</DepthTest>
	<BlendAttachment enable="false" srcColor="one" dstColor="zero" colorOp="add" srcAlpha="one" dstAlpha="zero" alphaOp="add">
	</BlendAttachment>
</PipelineDescription>