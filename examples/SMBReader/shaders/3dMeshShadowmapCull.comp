#version 450

#include "include/Math.iglsl"
#include "include/Mesh.iglsl"
#include "include/Lights.iglsl"

layout(push_constant) uniform GlobalContext 
{
	uint objCount;
	uint lightCount;
} gs;

layout(set = 0, binding = 0) uniform usamplerBuffer globalLightOffsets;
layout(set = 0, binding = 1) uniform usamplerBuffer globalLightCounts;
layout(set = 0, binding = 2) uniform usamplerBuffer globalLightAllocations;

layout(set = 0, binding = 3) uniform usamplerBuffer globalMeshCounts;
layout(set = 0, binding = 4) uniform usamplerBuffer globalMeshOffsets;
layout(set = 0, binding = 5) uniform usamplerBuffer globalMeshAllocations;

layout(set = 0, binding = 6) readonly buffer RENDBuffer
{
    MeshRenderable renderables[];
} rends;

layout(set = 0, binding = 7) readonly buffer PMBuffer 
{
    MeshDetails objects[];
} perModelBuffer;

layout(set = 0, binding = 8) readonly buffer GeomInstBuffer
{
    GeometryRenderable geomRenderables[];
} geomRends;

layout(set = 0, binding = 9) readonly buffer GLBuffer 
{
    LightSource objects[];
} lightBuffer;

layout(set = 0, binding = 10, r32ui) uniform uimageBuffer globalSMRenderableStart;
layout(set = 0, binding = 11, r32ui) uniform uimageBuffer globalSMRenderableCount;
layout(set = 0, binding = 12, r32ui) uniform uimageBuffer globalSMPerRendIndices;
layout(set = 0, binding = 13, r32ui) uniform uimageBuffer globalSMRenderableIndices;

layout(set = 0, binding = 14) writeonly buffer commandCounts 
{
    uint visibleCount;
    uint invisibleCount;
} cCounts;

layout(set = 0, binding = 15) writeonly buffer Commands 
{
	IndexedIndirectCommand commands[];
} cmdBuffer;

shared uint allocIndex;

const vec3 planeNormals[6] = vec3[](
                vec3(1.0, 0.0, 0.0),
                vec3(-1.0, 0.0, 0.0),
                vec3(0.0, 1.0, 0.0),
                vec3(0.0, -1.0, 0.0),
                vec3(0.0, 0.0, 1.0),
                vec3(0.0, 0.0, -1.0)
           );

const vec3 antiPlaneNormals[3] = vec3[](
                vec3(0.0, 1.0, 1.0),
                vec3(1.0, 0.0, 1.0),
                vec3(1.0, 1.0, 0.0)
           );


layout (local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

void main()
{
	uint lIndex =  gl_LocalInvocationID.x;

    if (lIndex == 0)
    {
        allocIndex = 0;
    }

    barrier();

	uint gridIndex = gl_WorkGroupID.x;

    uint lightOffsets =  texelFetch(globalLightOffsets, int(gridIndex)).r;
    uint lightCounts =  texelFetch(globalLightCounts, int(gridIndex)).r;
    uint meshOffsets =  texelFetch(globalMeshOffsets, int(gridIndex)).r;
    uint meshCounts =  texelFetch(globalMeshCounts, int(gridIndex)).r;

    if (meshCounts > lIndex)
    {
        uint dc = GET_LIGHT_TYPE_DIRECTIONAL_COUNT(lightCounts);
        uint poc = GET_LIGHT_TYPE_POINT_COUNT(lightCounts);
        uint sc = GET_LIGHT_TYPE_SPOT_COUNT(lightCounts);

        uint index = texelFetch(globalMeshAllocations, int(meshOffsets+lIndex)).r;

        uint geomInstIndex = rends.renderables[index].geomInstIndex;
    
        uint meshIndex = rends.renderables[index].meshIndex;

        vec4 sphere = perModelBuffer.objects[rends.renderables[index].meshIndex].sphere;

        mat4 worldM = geomRends.geomRenderables[geomInstIndex].transform * rends.renderables[index].transform;

        float r = sphere.w;

        vec3 sphereWPos = vec3(worldM * vec4(sphere.xyz, 1.0f));

        uint lightMeshCount = 0;

        uint lightStage = 0;

        uint ObjLightCopies[8]; 

        uint light = 0;

        for (;light<dc; light++)
        {
           uint lightIndex = texelFetch(globalLightAllocations, int(lightOffsets+light)).r;

           ObjLightCopies[lightMeshCount] = lightIndex;

           lightMeshCount++;
        }
            
        for (;light<dc+poc; light++)
        {
           uint lightIndex = texelFetch(globalLightAllocations, int(lightOffsets+light)).r;
        
           vec4 posLoad = lightBuffer.objects[lightIndex].pos;
        
           float lR = posLoad.w;
        
           vec3 posTest = posLoad.xyz;

           float perspectiveAngle = lightBuffer.objects[lightIndex].ancillary.w;
        
           vec3 pointToPointTest = sphereWPos - posTest;
        
           float totalRadius = lR + r;
        
           float d = dot(pointToPointTest, pointToPointTest);

           if (d <= totalRadius * totalRadius)
           {
                vec3 aabbCorner1 = (vec3(0.0, -1.0, -1.0) * lR * perspectiveAngle) + posTest;
                vec3 aabbCorner2 = (vec3(1.0, 1.0, 1.0) * lR * perspectiveAngle) + posTest;

                if (SphereIntersectsAABB(sphereWPos, r, aabbCorner1, aabbCorner2))
                {
                    ObjLightCopies[lightMeshCount] = (0 << LIGHT_SHADOW_MAP_CASCADE_OR_POINT_LIGHT_SLICE_OFF) | (lightIndex & LIGHT_SHADOW_MAP_LIGHT_INDEX_MASK);

                    lightMeshCount++;
                }

                aabbCorner1 = (vec3(-1.0, -1.0, -1.0) * lR * perspectiveAngle) + posTest;
                aabbCorner2 = (vec3(0.0, 1.0, 1.0) * lR * perspectiveAngle) + posTest;

                if (SphereIntersectsAABB(sphereWPos, r, aabbCorner1, aabbCorner2))
                {
                    ObjLightCopies[lightMeshCount] = (1 << LIGHT_SHADOW_MAP_CASCADE_OR_POINT_LIGHT_SLICE_OFF) | (lightIndex & LIGHT_SHADOW_MAP_LIGHT_INDEX_MASK);

                    lightMeshCount++;
                }

                 aabbCorner1 = (vec3(-1.0, 0.0, -1.0) * lR * perspectiveAngle) + posTest;
                 aabbCorner2 = (vec3(1.0, 1.0, 1.0) * lR * perspectiveAngle) + posTest;

                if (SphereIntersectsAABB(sphereWPos, r, aabbCorner1, aabbCorner2))
                {
                    ObjLightCopies[lightMeshCount] = (2 << LIGHT_SHADOW_MAP_CASCADE_OR_POINT_LIGHT_SLICE_OFF) | (lightIndex & LIGHT_SHADOW_MAP_LIGHT_INDEX_MASK);

                    lightMeshCount++;
                }

                aabbCorner1 = (vec3(-1.0, -1.0, -1.0) * lR * perspectiveAngle) + posTest;
                aabbCorner2 = (vec3(1.0, 0.0, 1.0) * lR * perspectiveAngle) + posTest;

                if (SphereIntersectsAABB(sphereWPos, r, aabbCorner1, aabbCorner2))
                {
                    ObjLightCopies[lightMeshCount] = (3 << LIGHT_SHADOW_MAP_CASCADE_OR_POINT_LIGHT_SLICE_OFF) | (lightIndex & LIGHT_SHADOW_MAP_LIGHT_INDEX_MASK);

                    lightMeshCount++;
                }

                aabbCorner1 = (vec3(-1.0, -1.0, 0.0) * lR * perspectiveAngle) + posTest;
                aabbCorner2 = (vec3(1.0, 1.0, 1.0) * lR * perspectiveAngle) + posTest;

                if (SphereIntersectsAABB(sphereWPos, r, aabbCorner1, aabbCorner2))
                {
                    ObjLightCopies[lightMeshCount] = (4 << LIGHT_SHADOW_MAP_CASCADE_OR_POINT_LIGHT_SLICE_OFF) | (lightIndex & LIGHT_SHADOW_MAP_LIGHT_INDEX_MASK);

                    lightMeshCount++;
                }

                
                aabbCorner1 = (vec3(-1.0, -1.0, -1.0) * lR * perspectiveAngle) + posTest;
                aabbCorner2 = (vec3(1.0, 1.0, 0.0) * lR * perspectiveAngle) + posTest;

                if (SphereIntersectsAABB(sphereWPos, r, aabbCorner1, aabbCorner2))
                {
                    ObjLightCopies[lightMeshCount] = (5 << LIGHT_SHADOW_MAP_CASCADE_OR_POINT_LIGHT_SLICE_OFF) | (lightIndex & LIGHT_SHADOW_MAP_LIGHT_INDEX_MASK);

                    lightMeshCount++;
                }
           }
        }
        
        for (;light<dc+poc+sc; light++)
        {
           uint lightIndex = texelFetch(globalLightAllocations, int(lightOffsets+light)).r;
        
           vec4 posLoad = lightBuffer.objects[lightIndex].pos;
           vec3 dirLoad = lightBuffer.objects[lightIndex].direction.xyz;
        
           bool addToLights = ConeIntersectSphere(posLoad.xyz, dirLoad, sphereWPos, r, posLoad.w, lightBuffer.objects[lightIndex].ancillary.y);
        
           if (addToLights)
           {
               ObjLightCopies[lightMeshCount] = lightIndex;

               lightMeshCount++;  
           } 
        }

        if (lightMeshCount == 0)
        {
            uint invisibleIndex = atomicAdd(cCounts.invisibleCount, 1u);
            cmdBuffer.commands[gs.objCount-(1+invisibleIndex)].instanceCount = 0;
            return;
        } 

        uint visibleIndex = atomicAdd(cCounts.visibleCount, 1u);
        uint smStartIndex = atomicAdd(allocIndex, lightMeshCount);

        imageStore(globalSMRenderableIndices, int(visibleIndex), uvec4(index, 0, 0, 0));
        imageStore(globalSMRenderableStart, int(index), uvec4(smStartIndex, 0, 0, 0));
        imageStore(globalSMRenderableCount, int(index), uvec4(lightMeshCount, 0, 0, 0));
   
        cmdBuffer.commands[visibleIndex].instanceCount = lightMeshCount;
        cmdBuffer.commands[visibleIndex].firstIndex = perModelBuffer.objects[meshIndex].firstIndex;
        cmdBuffer.commands[visibleIndex].indexCount = perModelBuffer.objects[meshIndex].indexCount;
        cmdBuffer.commands[visibleIndex].firstInstance = 0;
        cmdBuffer.commands[visibleIndex].vertexOffset = 0;

        for (uint lightIndex = 0; lightIndex<lightMeshCount; lightIndex++)
        { 
            imageStore(globalSMPerRendIndices, int(smStartIndex), uvec4(ObjLightCopies[lightIndex], 0, 0, 0));
            smStartIndex += 1;   
        }
    }

	return;
}