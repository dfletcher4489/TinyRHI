
#define LIGHT_TYPE_DIRECTIONAL 0
#define LIGHT_TYPE_POINT 1
#define LIGHT_TYPE_SPOT 2
#define LIGHT_TYPE_COUNT 3

#define LIGHT_TYPE_DIRECTIONAL_MAX_PWR2 9
#define LIGHT_TYPE_POINT_MAX_PWR2 10
#define LIGHT_TYPE_SPOT_MAX_PWR2 10

#define LIGHT_TYPE_DIRECTIONAL_MAX ((1u << LIGHT_TYPE_DIRECTIONAL_MAX_PWR2)-1)
#define LIGHT_TYPE_POINT_MAX ((1u << LIGHT_TYPE_POINT_MAX_PWR2)-1)
#define LIGHT_TYPE_SPOT_MAX ((1u << LIGHT_TYPE_SPOT_MAX_PWR2)-1)

#define LIGHT_TYPE_DIRECTIONAL_COUNT_OFF 0
#define LIGHT_TYPE_POINT_COUNT_OFF 9
#define LIGHT_TYPE_SPOT_COUNT_OFF 19

#define LIGHT_TYPE_DIRECTIONAL_COUNT_MULTIPLIER 1
#define LIGHT_TYPE_POINT_COUNT_MULTIPLIER (1u << LIGHT_TYPE_POINT_COUNT_OFF)
#define LIGHT_TYPE_SPOT_COUNT_MULTIPLIER (1u << LIGHT_TYPE_SPOT_COUNT_OFF)

#define GET_LIGHT_TYPE_DIRECTIONAL_COUNT(x) (((x) >> LIGHT_TYPE_DIRECTIONAL_COUNT_OFF) & LIGHT_TYPE_DIRECTIONAL_MAX)
#define GET_LIGHT_TYPE_POINT_COUNT(x) (((x) >> LIGHT_TYPE_POINT_COUNT_OFF) & LIGHT_TYPE_POINT_MAX)
#define GET_LIGHT_TYPE_SPOT_COUNT(x) (((x) >> LIGHT_TYPE_SPOT_COUNT_OFF) & LIGHT_TYPE_SPOT_MAX)

#define PACK_LIGHT_COUNT(dir, point, spot) \
	((((dir) & LIGHT_TYPE_DIRECTIONAL_MAX) << LIGHT_TYPE_DIRECTIONAL_COUNT_OFF) | \
	(((point) & LIGHT_TYPE_POINT_MAX) << LIGHT_TYPE_POINT_COUNT_OFF) | \
	(((spot) & LIGHT_TYPE_SPOT_MAX) << LIGHT_TYPE_SPOT_COUNT_OFF)) 

