#version 450

#extension GL_GOOGLE_include_directive: require

#include "include/Math.iglsl"
#include "include/Mesh.iglsl"
#include "include/Lights.iglsl"

struct UniformGrid
{
    vec4 max;
    vec4 min;
	uint numberOfDivisions;
    uint indirectDrawCount;
};

layout(push_constant) uniform GlobalContext 
{
    UniformGrid grid;    
} gs;

layout(set = 0, binding = 0) writeonly buffer Commands 
{
	IndexedIndirectCommand commands[];
} cmdBuffer;

layout(set = 0, binding = 1) buffer PMBuffer 
{
    MeshDetails objects[];
} perModelBuffer;

layout(set = 0, binding = 2) uniform CameraData 
{
     mat4 view;
     mat4 proj;
     mat4 world;
     Frustum f;
} cData;

layout(set = 0, binding = 3, r32ui) uniform uimageBuffer globalRenderableIndices;

layout(set = 0, binding = 4) writeonly buffer commandCounts 
{
    uint visibleCount;
    uint invisibleCount;
} cCounts;

layout(set = 0, binding = 5) buffer RENDBuffer
{
    MeshRenderable renderables[];
} rends;

layout(set = 0, binding = 6) readonly buffer GeomDescBuffer
{
    GeometryDetails details[];
} geomDetails;

layout(set = 0, binding = 7) readonly buffer GeomInstBuffer
{
    GeometryRenderable geomRenderables[];
} geomRends;

bool CheckAllPlanesAgainstAABB(AABB inputAABB, mat4 worldMatrix)
{
    AABB outAABBTransform = TransformAABBArvo(worldMatrix, inputAABB);

    vec4 transAABBMin =  outAABBTransform.min;
    vec4 transAABBMax =  outAABBTransform.max;

    vec4 AABBMin = min(transAABBMin, transAABBMax);
    vec4 AABBMax = max(transAABBMin, transAABBMax);

    Frustum testFrustrum = cData.f;

    bool check = CheckAABB(AABBMin, AABBMax, testFrustrum.nearplane.planeEquation);

    if (!check)
    {
        return false;
    }

    check = CheckAABB(AABBMin, AABBMax, testFrustrum.farplane.planeEquation);

    if (!check)
    {
        return false;
    }
    
    check = CheckAABB(AABBMin, AABBMax, testFrustrum.topplane.planeEquation);

    if (!check)
    {
        return false;
    }
    
    check = CheckAABB(AABBMin, AABBMax, testFrustrum.bottomplane.planeEquation);

    if (!check)
    {
        return false;
    }
    
    
    check = CheckAABB(AABBMin, AABBMax, testFrustrum.rightplane.planeEquation);

    if (!check)
    {
        return false;
    }
    
    check = CheckAABB(AABBMin, AABBMax, testFrustrum.leftplane.planeEquation);

    if (!check)
    {
        return false;
    }
    
    return true;
}

bool CheckAllPlanesAgainstSphere(mat4 worldMatrix, vec4 inSphere)
{
   float r = inSphere.w;

   vec3 transPosition =  vec3(worldMatrix * vec4(inSphere.xyz, 1.0));

   Frustum testFrustrum = cData.f;

   float dist = DistanceFromPlane(testFrustrum.nearplane.planeEquation, transPosition);

   if (dist < -r)
   {
       return false;
   }

   dist = DistanceFromPlane(testFrustrum.farplane.planeEquation, transPosition);

   if (dist < -r)
   {
       return false;
   }
   
   dist = DistanceFromPlane(testFrustrum.topplane.planeEquation, transPosition);

   if (dist < -r)
   {
       return false;
   }
   
   dist = DistanceFromPlane(testFrustrum.bottomplane.planeEquation, transPosition);

   if (dist < -r)
   {
       return false;
   }
    
   dist = DistanceFromPlane(testFrustrum.rightplane.planeEquation, transPosition);

   if (dist < -r)
   {
       return false;
   }
   
   dist = DistanceFromPlane(testFrustrum.leftplane.planeEquation, transPosition);

   if (dist < -r)
   {
       return false;
   }

   return true; 
}

shared uint wgVisibleCount;
shared uint wgInvisibleCount;

layout (local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

void main()
{
	uint index = (gl_WorkGroupID.x * gl_WorkGroupSize.x) + gl_LocalInvocationID.x;

    if (gl_LocalInvocationID.x == 0)
    {
        wgVisibleCount = 0;
        wgInvisibleCount = 0;
    }

    barrier();

    uint maxCount = gs.grid.indirectDrawCount;

    uint visible = 2, meshDetailsIndex = 0;

    if (index < maxCount)  
    {
        uint geomRenderableIndex = rends.renderables[index].geomInstIndex;

        meshDetailsIndex = rends.renderables[index].meshIndex;

        GeometryDetails lGeomDetails = geomDetails.details[geomRends.geomRenderables[geomRenderableIndex].geomDescIndex];

        mat4 worldM = geomRends.geomRenderables[geomRenderableIndex].transform * rends.renderables[index].transform;

        vec4 sphere = perModelBuffer.objects[meshDetailsIndex].sphere;

        rends.renderables[index].adjointMatrix = mat4(AdjointMatrix(worldM));

        visible = uint(CheckAllPlanesAgainstAABB(lGeomDetails.minMaxBox, worldM));
    }

    uint invisibleIndex = atomicAdd(wgInvisibleCount, (visible == 0) ? 1u : 0u);
    uint visibleIndex = atomicAdd(wgVisibleCount, (visible == 1) ? 1u : 0u);

    barrier();

    if (gl_LocalInvocationID.x == 0)
    {
       wgVisibleCount = atomicAdd(cCounts.visibleCount, wgVisibleCount);
       wgInvisibleCount = atomicAdd(cCounts.invisibleCount, wgInvisibleCount);
    }

    barrier();

    if (index < maxCount)  
    {
        uint writeOutIndex = (visible == 1) ? (wgVisibleCount+visibleIndex) : (maxCount-1) - (wgInvisibleCount+invisibleIndex);
   
        imageStore(globalRenderableIndices, int(writeOutIndex), uvec4(index, 0, 0, 0));

        cmdBuffer.commands[writeOutIndex].instanceCount = rends.renderables[index].instanceCount;
        cmdBuffer.commands[writeOutIndex].firstIndex = perModelBuffer.objects[meshDetailsIndex].firstIndex;
        cmdBuffer.commands[writeOutIndex].indexCount = perModelBuffer.objects[meshDetailsIndex].indexCount;
        cmdBuffer.commands[writeOutIndex].firstInstance = 0;
        cmdBuffer.commands[writeOutIndex].vertexOffset = 0;
    }
   
    return;
}
