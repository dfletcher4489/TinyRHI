#version 450

#extension GL_GOOGLE_include_directive: require

#include "include/Math.iglsl"
#include "include/Lights.iglsl"

struct UniformGrid
{
    vec4 max;
    vec4 min;
	uint numberOfDivisions;
};

layout(push_constant) uniform GlobalContext 
{
    UniformGrid grid;
} gs;

layout(set = 0, binding = 0) buffer LightCounts 
{
	uint count[];
} lightCounts;

layout(set = 0, binding = 1) readonly buffer GLBuffer 
{
    LightSource objects[];
} lightBuffer;

layout(set = 0, binding = 2) buffer LightAssigns 
{
	uint indices[];
} lightAssigns[LIGHT_TYPE_COUNT];

layout(set = 0, binding = 3) buffer GridCounts 
{
	uint count[];
} gridCounts;

shared uint perGridCount[32];

layout (local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

void main()
{
    if (gl_LocalInvocationID.x == 0 && gl_LocalInvocationID.y == 0)
    {
        for (uint i = 0; i<32; i++)
        {
            perGridCount[i] = 0;
        }
    }

    barrier();

    uint lIndex = (gl_WorkGroupID.x * gl_WorkGroupSize.x) + gl_LocalInvocationID.x;
    uint lightIndex = (gl_WorkGroupID.y * gl_WorkGroupSize.y) + gl_LocalInvocationID.y;

    uint x = lIndex / (gs.grid.numberOfDivisions*gs.grid.numberOfDivisions);
    uint y = (lIndex%(gs.grid.numberOfDivisions*gs.grid.numberOfDivisions)) / gs.grid.numberOfDivisions;
    uint z = lIndex % gs.grid.numberOfDivisions;

    vec4 range = gs.grid.max - gs.grid.min;
    vec3 cellDiv = range.xyz / float(gs.grid.numberOfDivisions);

    vec3 gridMinPoints = (vec3(x, y, z) * cellDiv) + gs.grid.min.xyz;
    vec3 gridMaxPoints = gridMinPoints + cellDiv;

    if (lIndex < (gs.grid.numberOfDivisions*gs.grid.numberOfDivisions*gs.grid.numberOfDivisions))
    {
        if (lightIndex < lightCounts.count[LIGHT_TYPE_POINT])
        {
            uint globalLightIndex = lightAssigns[LIGHT_TYPE_SPOT].indices[lightIndex];

            vec4 posLoad = lightBuffer.objects[globalLightIndex].pos;

            vec3 lightDir = lightBuffer.objects[globalLightIndex].direction.xyz;

            if (RayIntersectAABB(posLoad.xyz, lightDir, gridMinPoints, gridMaxPoints, posLoad.w)) 
            {
                atomicAdd(perGridCount[gl_LocalInvocationID.x], 1u);
            }
        }
    }

    barrier();

    if (gl_LocalInvocationID.x == 0 && gl_LocalInvocationID.y == 0)
    {
        uint lOffset = (gl_WorkGroupID.x * gl_WorkGroupSize.x);

        for (uint i = 0; i<32; i++)
        {
            atomicAdd(gridCounts.count[lOffset + i], perGridCount[i] * LIGHT_TYPE_SPOT_COUNT_MULTIPLIER);
        }
    }
  
	return;
}