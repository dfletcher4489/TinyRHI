#version 450

#extension GL_GOOGLE_include_directive: require

#include "include/Math.iglsl"
#include "include/Lights.iglsl"

struct UniformGrid
{
    vec4 max;
    vec4 min;
	uint numberOfDivisions;
};

layout(push_constant) uniform GlobalContext 
{
    UniformGrid grid;
} gs;

layout(set = 0, binding = 0) buffer LightCounts 
{
	uint count[];
} lightCounts;

layout(set = 0, binding = 1) readonly buffer GLBuffer 
{
    LightSource objects[];
} lightBuffer;

layout(set = 0, binding = 2) buffer LightAssigns
{
	uint indices[];
} lightAssigns[LIGHT_TYPE_COUNT];

layout(set = 0, binding = 3) buffer GridOffsets 
{
	uint offset[];
} gridOffsets;

layout(set = 0, binding = 4, r32ui) uniform uimageBuffer WorldAssignments;

layout(set = 0, binding = 5) buffer GridCounts 
{
	uint count[];
} gridCounts;

layout (local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

void main()
{
	uint lIndex =  (gl_WorkGroupID.x * gl_WorkGroupSize.x) + gl_LocalInvocationID.x;

    uint x = lIndex / (gs.grid.numberOfDivisions*gs.grid.numberOfDivisions);
    uint y = (lIndex%(gs.grid.numberOfDivisions*gs.grid.numberOfDivisions)) / gs.grid.numberOfDivisions;
    uint z = lIndex % gs.grid.numberOfDivisions;

    vec4 range = gs.grid.max - gs.grid.min;
    vec3 cellDiv = range.xyz / float(gs.grid.numberOfDivisions);

    vec3 gridMinPoints = (vec3(x, y, z) * cellDiv) + gs.grid.min.xyz;
    vec3 gridMaxPoints = gridMinPoints + cellDiv;

    if (lIndex < (gs.grid.numberOfDivisions*gs.grid.numberOfDivisions*gs.grid.numberOfDivisions))
    {
        uint baseIndex = gridOffsets.offset[lIndex];

        uint bitCount = gridCounts.count[lIndex];

        uint poff = GET_LIGHT_TYPE_DIRECTIONAL_COUNT(bitCount);

        uint lightCounter = 0;

        for (uint i = 0; i<lightCounts.count[LIGHT_TYPE_POINT]; i++)
        {
            uint lightIndex = lightAssigns[LIGHT_TYPE_POINT].indices[i];

            vec4 posLoad = lightBuffer.objects[lightIndex].pos;

            if (SphereIntersectsAABB(posLoad.xyz, posLoad.w, gridMinPoints, gridMaxPoints))  
            {
                imageStore(WorldAssignments, int(baseIndex + poff + lightCounter), uvec4(lightIndex, 0, 0, 0));
                lightCounter++;
            }
        }
    }

	return;
}